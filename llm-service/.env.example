PORT=3001
HOST=localhost

# Provider: openai | gemini | mock
AI_PROVIDER=mock

# Kunci API (wajib bila AI_PROVIDER=openai atau gemini)
AI_API_KEY=

# Nama model (opsional; bila kosong dipakai default per provider:
#   openai -> gpt-4o-mini, gemini -> gemini-2.0-flash)
AI_MODEL=
 
# Batas waktu panggilan LLM (ms), default 10000
AI_TIMEOUT_MS=10000

# Batas token keluaran (default 4096). Model reasoning (mis. deepseek-flash)
# memakai sebagian token untuk "reasoning_content", jadi butuh budget lebih besar
# dari batas skema (SRS 6.3: 900 T1 / 1400 T2). Naikkan bila content kosong.
AI_MAX_TOKENS=4096

# (opsional, untuk pengujian) path file berisi respon LLM palsu yang
# dikembalikan provider mock — dipakai untuk simulasi output rusak/terlarang.
AI_MOCK_RESPONSE_FILE=
