# Salin ke .env.production di server (atau .env di root) dan isi seluruh nilai rahasia.
# Dipakai oleh Docker Compose:
#   docker compose --env-file .env.production up -d --build

# PostgreSQL
POSTGRES_USER=root
POSTGRES_PASSWORD=ganti_dengan_password_postgres_kuat_minimal_24_karakter
POSTGRES_DB=db_wia

# Redis
REDIS_PASSWORD=ganti_dengan_password_redis_kuat_minimal_24_karakter

# Domain & URL Publik (opsional jika sama dengan default bordrex.my.id)
VITE_API_BASE_URL=https://bordrex.my.id/api
ALLOWED_ORIGINS=https://bordrex.my.id,http://bordrex.my.id
APP_BASE_URL=https://bordrex.my.id
