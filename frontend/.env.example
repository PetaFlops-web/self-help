# URL dasar untuk endpoint backend API (tanpa trailing slash)
VITE_API_BASE_URL=http://localhost:3000/api

# Batas waktu permintaan API dalam milidetik (default: 15000)
VITE_API_TIMEOUT_MS=15000

# Aktifkan fallback data demo kalau API gagal (default: true)
VITE_ENABLE_DEMO_FALLBACK=true

# UUID proyek unggulan di beranda (kosong = proyek skor tertinggi)
VITE_FEATURED_PROJECT_ID=
