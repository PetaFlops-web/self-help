# Backend — konfigurasi (salin ke .env dan isi)

# Mode: development | production
NODE_ENV=development

PORT=3000
HOST=localhost

# PostgreSQL (compose: db_wialmb, port 5433)
DATABASE_URL=postgresql://root:rootpassword@localhost:5433/db_wia

# SSL untuk koneksi database (production)
DATABASE_SSL=false

# Redis (compose: redis_wialmb, port 6379)
REDIS_URL=redis://localhost:6379

# LLM service (opsional; default http://localhost:3001)
LLM_SERVICE_URL=http://localhost:3001

# Batas waktu panggilan llm-service dalam ms (default 30000). Harus lebih besar
# dari total retry internal llm-service (10 detik + 1 retry).
LLM_SERVICE_TIMEOUT_MS=30000

# CORS allowed origins (pisah koma, hanya berlaku di production)
# Kosong = cors terbuka (dev behavior)
ALLOWED_ORIGINS=http://localhost:5173
